# Local development only. Copy to .env (gitignored) and fill in your workspace values.
# Authentication uses your Databricks CLI OAuth profile; never put tokens here.
DATABRICKS_CONFIG_PROFILE=DEFAULT
DATABRICKS_HOST=https://<workspace-host>
DATABRICKS_WORKSPACE_URL=https://<workspace-host>
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=bi-migration-review

# Upload Volume for migration inputs
DATABRICKS_VOLUME_FILES=/Volumes/<catalog>/<schema>/<volume>

# Datasource semantic workflow (semantic-model migration)
DATABRICKS_JOB_SEMANTIC_PROPOSAL=<propose-semantic-groups-job-id>
DATABRICKS_JOB_SEMANTIC_MIGRATION=<migrate-approved-semantic-groups-job-id>
DATASOURCE_SEMANTIC_OUTPUT_PATH=/Volumes/<catalog>/<schema>/<semantic-workflows-volume>

# Dashboard migration Jobs (feature currently hidden in the UI)
DATABRICKS_JOB_ID=<inventory-job-id>
DATABRICKS_JOB_INVENTORY=<inventory-job-id>
DATABRICKS_JOB_SEMANTIC=<semantic-build-job-id>
DATABRICKS_JOB_DASHBOARD_IMPORT=<dashboard-import-job-id>
DATABRICKS_JOB_METRIC_VIEW_REPAIR=<metric-view-repair-job-id>
