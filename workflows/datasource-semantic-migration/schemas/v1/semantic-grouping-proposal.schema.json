{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://databricks.example/bi-migration/semantic-grouping-proposal/1.0",
  "title": "Genie Semantic Grouping Proposal",
  "type": "object",
  "required": ["schema_version", "status", "groups", "ungrouped_datasources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "COMPLETE"},
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["display_name", "domain", "member_datasource_ids", "helper_datasource_ids", "rationale", "confidence"],
        "properties": {
          "display_name": {"type": "string", "minLength": 3},
          "domain": {"type": "string", "minLength": 2},
          "member_datasource_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "helper_datasource_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "rationale": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "ungrouped_datasources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["datasource_id", "classification", "reason"],
        "properties": {
          "datasource_id": {"type": "string", "minLength": 1},
          "classification": {"const": "UI_HELPER"},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
