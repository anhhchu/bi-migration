{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://databricks.example/bi-migration/workflow-manifest/1.0",
  "title": "Datasource Semantic Migration Workflow Manifest",
  "type": "object",
  "required": ["schema_version", "workflow_run_id", "job_run_id", "created_at", "generator", "status", "input", "runtime", "deployment"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "workflow_run_id": {"type": "string", "minLength": 1},
    "job_run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "generator": {"type": "object", "required": ["name", "version"]},
    "status": {"enum": ["SCAFFOLDED", "DISCOVERING", "RUNNING", "GROUPING_REVIEW_REQUIRED", "MIGRATION_RUNNING", "READY", "REVIEW_REQUIRED", "ACTION_REQUIRED", "COMPLETE", "COMPLETE_WITH_WARNINGS", "FAILED"]},
    "input": {"type": "object", "required": ["input_volume_path", "datasources_path", "mappings_path"]},
    "runtime": {"type": "object", "required": ["run_root", "groups_path", "reports_path", "internal_path"]},
    "deployment": {"type": "object", "required": ["candidate_catalog", "candidate_schema", "staging_schema", "warehouse_id"]},
    "grouping_approval_path": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
