{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://databricks.example/bi-migration/datasource-ir/1.0",
  "title": "Datasource Intermediate Representation",
  "type": "object",
  "required": ["schema_version", "workflow_run_id", "datasource_id", "datasource_name", "tableau_version", "source_path", "document_path", "package_hash", "connections", "relations", "relationships", "fields", "calculations", "parameters", "filters", "metadata", "warnings", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "workflow_run_id": {"type": "string", "minLength": 1},
    "datasource_id": {"type": "string", "minLength": 1},
    "datasource_name": {"type": ["string", "null"]},
    "tableau_version": {"type": ["string", "null"]},
    "source_path": {"type": "string", "pattern": "^/Volumes/"},
    "document_path": {"type": "string", "minLength": 1},
    "package_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "connections": {"type": "array", "items": {"type": "object"}},
    "relations": {"type": "array", "items": {"type": "object"}},
    "relationships": {"type": "array", "items": {"type": "object"}},
    "fields": {"type": "array", "items": {"type": "object"}},
    "calculations": {"type": "array", "items": {"type": "object"}},
    "parameters": {"type": "array", "items": {"type": "object"}},
    "filters": {"type": "array", "items": {"type": "object"}},
    "metadata": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "provenance": {"type": "object"}
  },
  "additionalProperties": false
}
