{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://databricks.example/bi-migration/metric-ir-index/1.0",
  "title": "Metric IR Index",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_run_id",
    "created_at",
    "datasource_ir_index_path",
    "metric_ir_root",
    "status",
    "summary",
    "datasources",
    "compile_results",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "workflow_run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "datasource_ir_index_path": {"type": "string", "pattern": "^/Volumes/"},
    "metric_ir_root": {"type": "string", "pattern": "^/Volumes/"},
    "status": {"const": "COMPLETE"},
    "summary": {
      "type": "object",
      "required": ["datasource_count", "dimension_count", "measure_count", "parameter_count", "finding_count", "status_counts"]
    },
    "datasources": {"type": "array", "items": {"type": "object"}},
    "compile_results": {"type": "array", "items": {"type": "string", "pattern": "^/Volumes/"}},
    "provenance": {"type": "object"}
  },
  "additionalProperties": false
}
