{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://databricks.example/bi-migration/genie-patch/1.0",
  "title": "Genie Semantic Translation Patch",
  "type": "object",
  "required": ["schema_version", "patch_id", "status", "failure_ids", "operations", "notes", "confidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "patch_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["APPLIED", "NOOP", "UNRESOLVABLE"]},
    "failure_ids": {"type": "array", "items": {"type": "string"}},
    "operations": {"type": "array", "items": {"type": "object"}},
    "notes": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": false
}
