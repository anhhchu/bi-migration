{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.databricks.com/bi-migration/mapping.schema.json",
  "title": "BI Migration Domain Mapping",
  "type": "object",
  "required": ["mapping_version", "domain", "status", "sources", "fields", "relationships", "kpis"],
  "properties": {
    "mapping_version": {"type": "string"},
    "domain": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "approved", "deprecated"]},
    "semantic_group": {"type": "string"},
    "coverage_signature": {"type": "string"},
    "sources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["datasource", "legacy", "assets", "confidence", "status", "evidence"],
        "properties": {
          "datasource": {"type": "string"},
          "legacy": {"type": "string"},
          "assets": {"type": "array", "items": {"type": "string"}},
          "target_table": {"type": "string"},
          "target_expression": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "status": {"enum": ["proposed", "approved", "unresolved", "rejected"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["datasource", "source", "target", "assets", "confidence", "status", "evidence"],
        "properties": {
          "datasource": {"type": "string"},
          "source": {
            "type": "object",
            "required": ["left_table", "right_table", "join_type", "condition", "source_kind"]
          },
          "target": {
            "type": "object",
            "required": ["left_table_candidates", "right_table_candidates", "join_type", "condition", "cardinality", "temporal_predicates", "record_filters"]
          },
          "assets": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "status": {"enum": ["proposed", "approved", "unresolved", "rejected"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "kpis": {"type": "array", "items": {"type": "object"}},
    "workbook_helpers": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
